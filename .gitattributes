# Normalisasi line ending — project ini di develop di Windows
* text=auto eol=lf

# File yang WAJIB LF (script, lockfile, konfigurasi)
*.sh            text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.json          text eol=lf
package.json    text eol=lf
package-lock.json text eol=lf

# Data & dokumen
*.md            text eol=lf
*.csv           text eol=lf

# Biner — jangan disentuh
*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.ico           binary
*.pdf           binary
*.xlsx          binary
*.pkl           binary
*.joblib        binary