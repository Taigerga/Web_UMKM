// Skema fondasi BisnisInsight - Prisma 7.
//
// Di Prisma 7 `datasource` TIDAK punya `url`; koneksi CLI lewat
// `prisma.config.ts`, dan koneksi runtime lewat driver adapter di
// `src/database/prisma.service.ts`.
//
// Penamaan: nama MODEL (dipakai sebagai nama delegate di Prisma Client,
// mis. `prisma.storeMembers`) memakai camelCase, sedangkan nama TABEL di
// MySQL tetap snake_case lewat `@@map`. Daftar ini adalah konsekuensi langsung
// dari `TENANT_MODELS` di `src/database/tenant-scope.extension.ts`.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

/// Peran platform: siapa orangnya di dalam sistem.
enum Role {
  ADMIN
  OWNER
  STAFF
}

enum StoreStatus {
  ACTIVE
  SUSPENDED
}

/// Peran orang di dalam satu toko. Sengaja terpisah dari `Role` supaya satu
/// orang bisa OWNER di toko A dan STAFF di toko B.
enum StoreMemberRole {
  OWNER
  STAFF
}

/// Akun orang.
model users {
  id               String    @id @default(uuid())
  email            String    @unique
  name             String    @db.VarChar(191)
  passwordHash     String    @db.VarChar(191)
  role             Role      @default(OWNER)
  isActive         Boolean   @default(true)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  storesCreated stores[]         @relation("StoreCreator")
  memberships  storeMembers[]
  invitesSent  storeInvites[]   @relation("InviteSender")
  sessions     refreshTokens[]
  auditLogs    auditLogs[]
  datasets    datasets[]

  @@map("users")
}

model stores {
  id          String      @id @default(uuid())
  name        String      @db.VarChar(191)
  city        String?
  timezone    String      @default("Asia/Jakarta")
  status      StoreStatus @default(ACTIVE)
  createdById String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  createdBy users           @relation("StoreCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members  storeMembers[]
  invites  storeInvites[]
  datasets datasets[]
  products products[]
  customers customers[]
  orders   orders[]

  @@map("stores")
}

/// Membership = satu orang dalam satu toko.
model storeMembers {
  storeId  String
  userId   String
  role     StoreMemberRole @default(STAFF)
  joinedAt DateTime        @default(now())

  store stores @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user  users  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([storeId, userId])
  @@index([userId])
  @@map("store_members")
}

model storeInvites {
  id          String          @id @default(uuid())
  storeId     String
  email       String          @db.VarChar(191)
  tokenHash   String          @unique @db.VarChar(64)
  role        StoreMemberRole
  expiresAt   DateTime
  acceptedAt  DateTime?
  invitedById String
  createdAt   DateTime        @default(now())

  store     stores @relation(fields: [storeId], references: [id], onDelete: Cascade)
  invitedBy users  @relation("InviteSender", fields: [invitedById], references: [id], onDelete: Restrict)

  @@index([storeId, email])
  @@map("store_invites")
}

model refreshTokens {
  id           String    @id @default(uuid())
  userId       String
  tokenHash    String    @unique @db.VarChar(64)
  familyId     String    @db.VarChar(36)
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  createdAt    DateTime  @default(now())

  user users @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Jejak audit. `storeId` sengaja TANPA foreign key: log harus tetap terbaca
/// setelah tokonya dihapus. `meta Json?` untuk detail terstruktur.
model auditLogs {
  id        String   @id @default(uuid())
  actorId   String?
  storeId   String?
  action    String   @db.VarChar(64)
  entity    String   @db.VarChar(64)
  entityId  String?
  ip        String   @db.VarChar(45)
  userAgent String   @db.VarChar(255)
  meta      Json?
  createdAt DateTime @default(now())

  actor users? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([storeId, createdAt])
  @@index([actorId])
  @@map("audit_logs")
}

enum DatasetStatus {
  UPLOADED
  VALIDATED
  IMPORTED
  ROLLED_BACK
  FAILED
}

enum DatasetIssueSeverity {
  FATAL
  AUTO_FIX
  WARN
  ACCEPT
}

model datasets {
  id          String        @id @default(uuid())
  storeId     String        @map("store_id")
  uploadedById String       @map("uploaded_by_id")
  status      DatasetStatus @default(UPLOADED)
  fileName    String        @db.VarChar(255) @map("file_name")
  filePath    String        @db.VarChar(1024) @map("file_path")
  fileHash    String        @db.VarChar(64) @map("file_hash")
  mimeType    String        @db.VarChar(120) @map("mime_type")
  rowCount    Int           @default(0) @map("row_count")
  committedAt DateTime?     @map("committed_at")
  importedAt  DateTime?     @map("imported_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  store       stores        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  uploadedBy users         @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  mappings    datasetMappings[]
  issues      datasetIssues[]
  orders      orders[]

  @@index([storeId, createdAt])
  @@map("datasets")
}

model datasetMappings {
  id         String   @id @default(uuid())
  datasetId String    @map("dataset_id")
  mappingJson Json     @map("mapping_json")
  createdAt   DateTime @default(now()) @map("created_at")

  dataset datasets @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@map("dataset_mappings")
}

model datasetIssues {
  id         String               @id @default(uuid())
  datasetId  String               @map("dataset_id")
  severity   DatasetIssueSeverity @default(WARN)
  code       String               @db.VarChar(64)
  rowNumber  Int?                 @map("row_number")
  columnName String?              @db.VarChar(127) @map("column_name")
  message    String               @db.VarChar(255)
  count      Int                  @default(1)
  createdAt  DateTime             @default(now()) @map("created_at")

  dataset datasets @relation(fields: [datasetId], references: [id], onDelete: Cascade)

  @@index([datasetId, severity])
  @@map("dataset_issues")
}

model products {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  sku       String   @db.VarChar(64)
  name      String   @db.VarChar(191)
  category  String?  @db.VarChar(127)
  unit      String?  @db.VarChar(32)
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  store       stores            @relation(fields: [storeId], references: [id], onDelete: Cascade)
  prices      productPrices[]
  orderItems  orderItems[]

  @@unique([storeId, sku])
  @@index([storeId, name])
  @@map("products")
}

model productPrices {
  id        String   @id @default(uuid())
  productId String   @map("product_id")
  price     Decimal  @db.Decimal(14, 2)
  effectiveFrom DateTime @default(now()) @map("effective_from")
  createdAt DateTime  @default(now()) @map("created_at")

  product products @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, effectiveFrom])
  @@map("product_prices")
}

model customers {
  id        String   @id @default(uuid())
  storeId   String   @map("store_id")
  code      String   @db.VarChar(64)
  name      String   @db.VarChar(191)
  segment   String?  @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  store  stores      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders orders[]

  @@unique([storeId, code])
  @@index([storeId, name])
  @@map("customers")
}

model orders {
  id          String   @id @default(uuid())
  storeId     String   @map("store_id")
  datasetId   String?  @map("dataset_id")
  customerId  String?  @map("customer_id")
  orderDate   DateTime @map("order_date")
  channel     String?  @db.VarChar(64)
  total       Decimal? @db.Decimal(14, 2)
  status      String   @default("CONFIRMED") @db.VarChar(32)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  store    stores     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  dataset  datasets?  @relation(fields: [datasetId], references: [id], onDelete: SetNull)
  customer customers? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    orderItems[]

  @@index([storeId, orderDate])
  @@index([storeId, customerId])
  @@map("orders")
}

model orderItems {
  id        String   @id @default(uuid())
  orderId   String   @map("order_id")
  productId String?  @map("product_id")
  qty       Decimal  @db.Decimal(14, 4)
  price     Decimal  @db.Decimal(14, 2)
  discount  Decimal? @db.Decimal(14, 2)

  order    orders     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product  products?  @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}
