# Runtime
NODE_ENV=development
PORT=3000

# Database (MySQL 8.4 via Laragon)
# Wajib. Driver adapter Prisma 7 memakai @prisma/adapter-mariadb.
DATABASE_URL="mysql://root@127.0.0.1:3306/bisnis_insight_analytics_db"

# Auth - Wajib, minimal 32 karakter. Aplikasi menolak start kalau kurang.
JWT_SECRET="ganti-dengan-random-string-minimal-32-karakter-panjang"

ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
ACCESS_COOKIE_NAME=bi_at
REFRESH_COOKIE_NAME=bi_rt

# CORS - daftar origin dipisah koma. Tanpa wildcard.
#
# CATATAN untuk pengembangan lokal: frontend Next.js berjalan di port 3001,
# bukan 3000. Kalau `apps/frontend` dijalankan dengan `npm run dev`, origin
# `http://localhost:3001` WAJIB ada di daftar ini. Kalau tidak, setiap request
# dari browser ditolak dan form auth gagal tanpa ada error di log backend:
#
#   CORS_ORIGINS=http://localhost:3000,http://localhost:3001
#
# Untuk produksi isi HANYA origin frontend Anda. Menambahkan origin dev ke
# konfigurasi produksi berarti mengizinkan origin tersebut membawa cookie
# sesi lintas origin.
CORS_ORIGINS=http://localhost:3000

# Layanan ML Python (Fase 3). Dipakai service analitik untuk memanggil model.
ML_SERVICE_URL=http://127.0.0.1:8000
