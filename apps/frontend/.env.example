# Konfigurasi frontend. Salin ke `.env.local` dan sesuaikan.
#
# `NEXT_PUBLIC_*` di-inline ke bundle saat BUILD, bukan saat runtime.
# Mengganti nilainya berarti build ulang - bukan hanya restart `next dev`.

# Origin backend API.
#
# WAJIB diisi untuk produksi. Tanpa baris ini frontend memakai default
# `http://localhost:3000`, dan build yang kelupaan mengaturnya akan menjadi
# frontend yang menembak localhost milik user. Gejalanya baru muncul saat
# dipakai, dan muncul sebagai "tidak bisa menghubungi server".
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Nama cookie access token.
#
# Harus sama dengan `ACCESS_COOKIE_NAME` di backend. Default backend adalah
# `bi_at`, jadi biasanya baris ini tidak perlu diisi; isi hanya kalau backend
# dikonfigurasi dengan nama lain.
#
# Nama ini dipakai di dua tempat - pembaca cookie di peramban dan gate
# `/dashboard/*` di `proxy.ts` - dan keduanya mengimpor dari satu konstanta,
# jadi mengganti nilainya di sini tidak bisa membuat keduanya berbeda diam-diam.
NEXT_PUBLIC_ACCESS_COOKIE_NAME=bi_at
